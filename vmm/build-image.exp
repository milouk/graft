#!/usr/bin/expect -f
#
# build-image.exp — make what graft-run boots, in a directory:
#
#   root.squashfs    the VM's root filesystem: Alpine Linux and a container
#                    runtime, compressed and read-only
#   data.img         its /var/lib: images, containers, volumes
#   initramfs-graft  an initramfs that can mount both
#   cmdline          what the kernel has to be told
#   flavor.env       how the runtime is reached; read by vmm/graft
#   id_graft         an SSH key the VM accepts for root
#
#   ./build-image.exp <qemu-system-x86_64> <alpine-virt.iso> <output dir>
#
# This is a build tool, not part of running a VM. It boots the Alpine ISO in
# QEMU and runs vmm/guest-build.sh inside it. The script reaches the guest as
# a disk, and the results come back out through another, because the host
# cannot read a Linux filesystem; so the only thing typed at the guest is a
# login and one command.
#
# In the environment:
#   ACCEL   QEMU's accelerator. The default, software emulation, needs no
#           driver and no root and is slow; "nvmm" is quick.
#   FLAVOR  what the VM runs containers with: the name of a file in flavors/,
#           "containerd" by default. Adding a runtime is adding a file there.
#   IMAGES  container images to pull into data.img as it is built, so that
#           they are there without a network. None by default.
#   SIZE    the size of data.img (default 8G; it only takes the space used).
#   RESET_DATA  set to 1 to replace a data.img that is already there.
#
# A data.img already in the output directory is kept: it holds the images,
# containers and volumes, and rebuilding the root, or changing runtime, is no
# reason to lose them. The rest is replaced, and only once the build has
# succeeded.
#
# The Alpine release in guest-build.sh must match the ISO, whose kernel
# modules the image uses, and graft-run must boot that same kernel: the
# vmlinuz-virt in the release's netboot directory.

if {$argc != 3} {
    puts "usage: build-image.exp <qemu-system-x86_64> <alpine-virt.iso> <output dir>"
    exit 2
}
lassign $argv qemu iso outdir

# Read the console as bytes: a multi-byte character split across two reads
# otherwise fails the read, and Expect takes that for the end of the console.
encoding system iso8859-1

set accel tcg
if {[info exists env(ACCEL)]} { set accel $env(ACCEL) }
set size 8G
if {[info exists env(SIZE)]} { set size $env(SIZE) }
set flavor containerd
if {[info exists env(FLAVOR)]} { set flavor $env(FLAVOR) }

set outdir [file normalize $outdir]
set here [file dirname [file normalize [info script]]]
set data $outdir/data.img
set rootfs $outdir/root.squashfs
set initramfs $outdir/initramfs-graft
set work $outdir/build-data.img
set script $outdir/build-script.img
set scratch $outdir/build-scratch.img
set sock $outdir/build-serial.sock
set qerr $outdir/build-qemu.err
set qimg [file dirname $qemu]/qemu-img
# Checked before anything is deleted: a mistyped name must not cost the
# image that is already there.
set ffile $here/flavors/$flavor.sh
if {![file exists $ffile]} {
    puts "### no such flavor: $flavor (see [file join $here flavors])"
    exit 2
}
set images ""
if {[info exists env(IMAGES)]} { set images $env(IMAGES) }
set keepdata [expr {[file exists $data] &&
    !([info exists env(RESET_DATA)] && $env(RESET_DATA) eq "1")}]
if {$keepdata && $images ne ""} {
    puts "### IMAGES are pulled into a new data.img, and $data exists."
    puts "### Set RESET_DATA=1 to replace it, or pull them in the running VM."
    exit 2
}
file mkdir $outdir
file delete -force $sock $work $script $scratch

# The first disk is where the tree is put together; it ends up as the data
# disk. The scratch disk carries the initramfs and the squashfs out.
exec $qimg create -f raw $work $size
exec $qimg create -f raw $scratch 1G
# A key pair for the host to reach the VM with. Kept if it is already there,
# so that rebuilding the image does not lock out a running setup's key.
set key $outdir/id_graft
if {![file exists $key]} {
    exec ssh-keygen -q -t ed25519 -N "" -C graft -f $key
}
set fh [open $key.pub]
set pubkey [string trim [read $fh]]
close $fh

# The script, with the public key in front of it, padded to a whole number
# of sectors with newlines.
exec sh -c "printf 'PUBKEY=\"%s\"\nIMAGES=\"%s\"\n' '$pubkey' '$images' > '$script'; \
    cat '$ffile' '$here/guest-build.sh' >> '$script'; \
    n=\$(wc -c < '$script'); pad=\$(( (512 - n % 512) % 512 + 512 )); \
    awk -v n=\$pad 'BEGIN { for (i = 0; i < n; i++) printf \"\\n\" }' >> '$script'"

set qpid [exec $qemu -accel $accel -M q35 -m 2G -display none \
    -monitor none -serial unix:$sock,server=on,wait=off -cdrom $iso \
    -drive file=$work,if=virtio,format=raw \
    -drive file=$script,if=virtio,format=raw,readonly=on \
    -drive file=$scratch,if=virtio,format=raw \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
    < /dev/null > $qerr 2>@1 &]
for {set i 0} {$i < 50 && ![file exists $sock]} {incr i} { after 100 }
if {![file exists $sock]} { puts "### QEMU did not start; see $qerr"; exit 1 }

proc fail {msg} {
    global qpid
    puts "\n### $msg"
    catch {exec kill $qpid}
    exit 1
}

set timeout 300
spawn nc -U $sock
expect {
    "login: " {}
    timeout { fail "TIMEOUT waiting for the login prompt" }
}
send "root\r"
expect "localhost:~# "
# Let the shell finish asking the terminal where its cursor is; typing
# into the middle of that can lose keystrokes.
after 2000
send "sh /dev/vdb\r"

set isize 0
set ssize 0
set timeout 3600
expect {
    -re {@@INITRAMFS-SIZE:([0-9]+)@@} { set isize $expect_out(1,string); exp_continue }
    -re {@@SQUASHFS-SIZE:([0-9]+)@@} { set ssize $expect_out(1,string); exp_continue }
    -re {@@RESULT:([0-9]+)@@} {
        if {$expect_out(1,string) != 0} { fail "the build failed inside the guest" }
    }
    timeout { fail "TIMEOUT during the build" }
    eof { fail "CONSOLE CLOSED during the build" }
}

expect "localhost:~# "
after 2000
send "poweroff\r"
set timeout 120
expect eof
for {set i 0} {$i < 100 && ![catch {exec kill -0 $qpid}]} {incr i} { after 200 }

if {$isize <= 0 || $ssize <= 0} { puts "### sizes not reported"; exit 1 }
# Under other names first, so that what was there stays whole until all of
# the new image is.
exec head -c $isize $scratch > $initramfs.new
# The squashfs starts SQUASHFS_AT megabytes in; see guest-build.sh.
exec sh -c "dd if='$scratch' bs=1048576 skip=64 2>/dev/null | head -c $ssize > '$rootfs.new'"
if {[file size $initramfs.new] != $isize || [file size $rootfs.new] != $ssize} {
    puts "### the image did not come out of the build whole"
    exit 1
}
file rename -force $initramfs.new $initramfs
file rename -force $rootfs.new $rootfs
if {$keepdata} {
    file delete -force $work
    set datanote "$data kept as it was"
} else {
    file rename -force $work $data
    set datanote "a new $data"
}
# What the kernel has to be told to boot this image.
set fh [open $outdir/cmdline w]
puts $fh "root=/dev/vda rootfstype=squashfs overlaytmpfs=yes modules=squashfs,overlay,ext4 quiet"
close $fh
file delete -force $script $scratch $sock
# What graft needs to know about the image, in a form it can source.
exec sh -c ". '$ffile'; printf 'FLAVOR=%s\nFLAVOR_SOCKET=%s\nFLAVOR_CLI=%s\n' \
    '$flavor' \"\$FLAVOR_SOCKET\" \"\$FLAVOR_CLI\" > '$outdir/flavor.env'"
puts "\n### built $rootfs ($flavor, $ssize bytes) and $initramfs; $datanote; key in $key"
