#!/bin/sh
#
# graft — run the container VM in the background and connect this Mac
# to it.
#
#   graft start     boot the VM and wait until its runtime answers
#   graft stop      shut the VM down
#   graft status    say whether it is running
#   graft console   show what the VM has printed
#   graft ssh [cmd] a shell, or a command, in the VM
#   graft <cli> …   the runtime's own command, run in the VM
#
# It needs, in $GRAFT_DIR (default ~/.graft), what
# vmm/build-image.exp makes, plus the kernel: vmlinuz-virt, initramfs-graft,
# root.squashfs, data.img, cmdline, id_graft and flavor.env. And on the PATH, or named by $GRAFT_RUN
# and $GVPROXY: graft-run and gvproxy. GRAFT_CPUS and GRAFT_MEM
# (megabytes) size the VM; the defaults are one CPU and 2048.
#
# What the image runs containers with was chosen when it was built (see
# vmm/flavors/), and decides how this Mac reaches it:
#
#   - A runtime with an API socket (docker, podman) is given a socket in that
#     directory, which only its owner can open: point DOCKER_HOST at it.
#     gvproxy carries it to the VM over SSH, with the image's key.
#   - A runtime with a command of its own (nerdctl, podman) can be run in the
#     VM: "graft nerdctl run --rm alpine true".
#
# The VM sees this Mac's home directory, at the same path, so a bind mount
# of something under it (-v "$PWD:/app") works as it would with containers
# run here. GRAFT_SHARE names another directory, or nothing if empty. A path
# with spaces in it is refused.
#
# Ports that containers publish (-p) appear on this Mac too, on the loopback
# address; set GRAFT_BIND=0.0.0.0 to offer them to the network as
# well. TCP only.

set -eu

DIR=${GRAFT_DIR:-"$HOME/.graft"}
GRAFT_RUN=${GRAFT_RUN:-graft-run}
GVPROXY=${GVPROXY:-gvproxy}
MEM=${GRAFT_MEM:-2048}
CPUS=${GRAFT_CPUS:-1}
SSH_PORT=${GRAFT_SSH_PORT:-2222}
# What of this Mac the VM sees, at the same path. Empty: nothing.
SHARE=${GRAFT_SHARE-"$HOME"}
SOCK="$DIR/docker.sock"
CTL="$DIR/ctl.sock"
BIND=${GRAFT_BIND:-127.0.0.1}
GUEST=192.168.127.2		# the address gvproxy gives the VM
FLAVOR=containerd
FLAVOR_SOCKET=
FLAVOR_CLI=nerdctl
[ -f "$DIR/flavor.env" ] && . "$DIR/flavor.env"

# The VM mounts the share at the path it has here, so that has to be a whole
# path, and one the kernel command line can carry.
if [ -n "$SHARE" ]; then
	SHARE=$(CDPATH='' cd -- "$SHARE" 2>/dev/null && pwd -P) ||
	    { echo "GRAFT_SHARE is not a directory: ${GRAFT_SHARE-$HOME}" >&2; exit 1; }
	case "$SHARE" in
	*[[:space:]]*) echo "GRAFT_SHARE has a space in it, which is not handled: $SHARE" >&2; exit 1 ;;
	esac
fi

vm_pid()  { cat "$DIR/vm.pid" 2>/dev/null || true; }
net_pid() { cat "$DIR/gvproxy.pid" 2>/dev/null || true; }
alive()   { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
ping_docker() {
	[ "$(curl -s -m 2 --unix-socket "$SOCK" http://docker/_ping 2>/dev/null)" = "OK" ]
}
vm_ssh() {
	ssh -q -i "$DIR/id_graft" -p "$SSH_PORT" -o StrictHostKeyChecking=no \
	    -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 \
	    root@127.0.0.1 "$@"
}
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
# Is the container runtime answering? Ask its socket if it has one.
runtime_up() {
	if [ -n "$FLAVOR_SOCKET" ]; then
		ping_docker
	else
		vm_ssh "$FLAVOR_CLI" info > /dev/null 2>&1
	fi
}
# The TCP ports containers have published, one per line.
published_ports() {
	if [ -z "$FLAVOR_SOCKET" ]; then
		vm_ssh "$FLAVOR_CLI ps --format '{{.Ports}}'" 2>/dev/null |
		    grep -o ':[0-9]*->[0-9]*/tcp' | grep -o '^:[0-9]*' | tr -d :
	else
		curl -s -m 3 --unix-socket "$SOCK" \
		    http://docker/containers/json 2>/dev/null |
		    grep -o '"PublicPort":[0-9]*,"Type":"tcp"' |
		    grep -o '[0-9][0-9]*'
	fi
}

forwarder() {	# forwarder expose|unexpose <json>
	curl -s -m 3 --unix-socket "$CTL" -X POST -d "$2" \
	    "http://gvproxy/services/forwarder/$1" > /dev/null 2>&1 || true
}

# Keep the Mac's ports in step with what containers publish.
watch_ports() {
	have=""
	while alive "$(vm_pid)"; do
		want=$(published_ports | sort -un | tr '\n' ' ')
		for p in $want; do
			case " $have " in *" $p "*) continue ;; esac
			forwarder expose "{\"local\":\"$BIND:$p\",\"remote\":\"$GUEST:$p\"}"
		done
		for p in $have; do
			case " $want " in *" $p "*) continue ;; esac
			forwarder unexpose "{\"local\":\"$BIND:$p\"}"
		done
		have=$want
		# Without a socket, asking means an SSH login each time.
		[ -z "$FLAVOR_SOCKET" ] && sleep 3
		sleep 2
	done
}

start() {
	if alive "$(vm_pid)"; then
		echo "already running (pid $(vm_pid))"
		return 0
	fi
	for f in vmlinuz-virt initramfs-graft root.squashfs data.img cmdline \
	    id_graft flavor.env; do
		[ -f "$DIR/$f" ] || { echo "missing $DIR/$f" >&2; exit 1; }
	done
	[ -e /dev/nvmm ] || { echo "/dev/nvmm is not there; is NVMM.kext loaded?" >&2; exit 1; }

	# gvproxy is the VM's network, and it also carries the Docker socket:
	# it keeps trying the VM's SSH server until that is up.
	rm -f "$DIR/net.sock" "$DIR/console.in" "$SOCK" "$CTL"
	if [ -z "$FLAVOR_SOCKET" ]; then
		"$GVPROXY" -listen "unix://$CTL" \
		    -listen-qemu "unix://$DIR/net.sock" -ssh-port "$SSH_PORT" \
		    -pid-file "$DIR/gvproxy.pid" -log-file "$DIR/gvproxy.log" \
		    > /dev/null 2>&1 &
	else
		"$GVPROXY" -listen "unix://$CTL" \
		    -listen-qemu "unix://$DIR/net.sock" -ssh-port "$SSH_PORT" \
		    -forward-sock "$SOCK" -forward-dest "$FLAVOR_SOCKET" \
		    -forward-user root -forward-identity "$DIR/id_graft" \
		    -pid-file "$DIR/gvproxy.pid" -log-file "$DIR/gvproxy.log" \
		    > /dev/null 2>&1 &
	fi
	i=0
	while [ ! -S "$DIR/net.sock" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
	[ -S "$DIR/net.sock" ] || { echo "gvproxy did not start; see $DIR/gvproxy.log" >&2; exit 1; }

	# The VM's console: what it prints goes to a file, and what it reads
	# comes from a pipe, which is how "stop" asks it to shut down.
	mkfifo "$DIR/console.in"
	"$GRAFT_RUN" -k "$DIR/vmlinuz-virt" -i "$DIR/initramfs-graft" \
	    -r "$DIR/root.squashfs" -d "$DIR/data.img" \
	    -n "$DIR/net.sock" -m "$MEM" -c "$CPUS" \
	    ${SHARE:+-s "$SHARE"} \
	    -a "$(cat "$DIR/cmdline")${SHARE:+ graft.share=$SHARE}" \
	    0<> "$DIR/console.in" > "$DIR/console.log" 2>&1 &
	echo $! > "$DIR/vm.pid"

	i=0
	while [ $i -lt 120 ]; do
		alive "$(vm_pid)" || { echo "the VM stopped; see $DIR/console.log" >&2; exit 1; }
		if runtime_up; then
			watch_ports > /dev/null 2>&1 &
			echo $! > "$DIR/ports.pid"
			echo "$FLAVOR is up. Use it with:"
			[ -n "$FLAVOR_SOCKET" ] &&
			    echo "  export DOCKER_HOST=unix://$SOCK"
			[ -n "$FLAVOR_CLI" ] &&
			    echo "  $0 $FLAVOR_CLI run --rm alpine uname -a"
			return 0
		fi
		sleep 0.5
		i=$((i + 1))
	done
	echo "the VM is running but $FLAVOR did not answer; see $DIR/console.log" >&2
	exit 1
}

stop() {
	pid=$(vm_pid)
	if alive "$pid"; then
		# Ask over SSH; failing that, log in on the console and ask there.
		if ! vm_ssh poweroff 2>/dev/null; then
			printf '\rroot\r' > "$DIR/console.in"
			sleep 2
			printf 'poweroff\r' > "$DIR/console.in"
		fi
		i=0
		while alive "$pid" && [ $i -lt 60 ]; do sleep 0.5; i=$((i + 1)); done
		if alive "$pid"; then
			echo "the VM did not shut down; stopping it" >&2
			kill "$pid"
		fi
	fi
	wpid=$(cat "$DIR/ports.pid" 2>/dev/null || true)
	alive "$wpid" && kill "$wpid"
	alive "$(net_pid)" && kill "$(net_pid)"
	rm -f "$DIR/vm.pid" "$DIR/gvproxy.pid" "$DIR/ports.pid" \
	    "$DIR/net.sock" "$SOCK" "$CTL" "$DIR/console.in"
	echo "stopped"
}

case "${1:-}" in
start)   start ;;
stop)    stop ;;
status)
	if alive "$(vm_pid)"; then
		echo "running (pid $(vm_pid)); $FLAVOR $(runtime_up && echo answers || echo "does not answer")"
	else
		echo "not running"
	fi ;;
console) cat "$DIR/console.log" ;;
ssh)	 shift; vm_ssh "$@" ;;
"")	 echo "usage: graft start|stop|status|console|ssh|<cli>" >&2; exit 2 ;;
"$FLAVOR_CLI")
	# The runtime's own command, in the VM. ssh joins its arguments with
	# spaces and the far shell splits them again, so each is quoted for
	# that shell first. It runs in the directory this was called from,
	# when the VM has it, so relative paths mean the same there.
	cmd="cd $(quote "$PWD") 2>/dev/null; $1"
	shift
	for a in "$@"; do
		cmd="$cmd $(quote "$a")"
	done
	if [ -t 0 ]; then vm_ssh -t "$cmd"; else vm_ssh "$cmd"; fi ;;
*)	 echo "usage: graft start|stop|status|console|ssh|<cli>" >&2; exit 2 ;;
esac
