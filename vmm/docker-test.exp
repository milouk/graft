#!/usr/bin/expect -f
#
# docker-test.exp — boot the image made by build-image.exp in nvmm-run, with
# no QEMU involved, and run Docker in it.
#
#   ./docker-test.exp <nvmm-run> <vmlinuz> <initramfs> <rootfs.img>
#
# NET=1 in the environment gives the VM a network card (needs root) and adds
# a pull from Docker Hub to the test.

if {$argc != 4} {
    puts "usage: docker-test.exp <nvmm-run> <vmlinuz> <initramfs> <rootfs.img>"
    exit 2
}
lassign $argv vmm kernel initramfs rootfs
encoding system iso8859-1

set net [expr {[info exists env(NET)] && $env(NET) ne "0"}]
set args [list -k $kernel -i $initramfs -d $rootfs -m 2048 \
    -a "root=/dev/vda rootfstype=ext4 modules=ext4 quiet"]
if {$net} { lappend args -n }

set timeout 120
spawn $vmm {*}$args
set prompt {nvmm:~# (\x1b\[6n)?$}

proc run {cmd {t 120}} {
    global prompt
    set timeout $t
    # The shell asks the terminal for its cursor position after each prompt;
    # let that pass before typing.
    after 700
    send -- "$cmd\r"
    expect {
        -re $prompt {}
        timeout { puts "\n### TIMEOUT after: $cmd"; exit 1 }
        eof { puts "\n### THE VMM EXITED during: $cmd"; exit 1 }
    }
}

expect {
    "login: " {}
    timeout { puts "\n### TIMEOUT waiting for the login prompt"; exit 1 }
    eof { puts "\n### THE VMM EXITED before login"; exit 1 }
}
after 700
send "root\r"
expect -re $prompt

run {uname -a; nproc; free -m | head -2; date; cat /proc/cmdline}
run {cat /proc/interrupts | head -12}
run {for i in $(seq 30); do docker info >/dev/null 2>&1 && break; sleep 2; done; docker version | grep -E "^(Client|Server)| Version"} 120
run {docker ps -a}
run {docker images}
run {docker run --rm hello-world | head -4} 300
run {docker run --rm alpine sh -c "echo hello from a container on \$(uname -m), kernel \$(uname -r)"} 300
if {$net} {
    run {ip -4 addr show eth0 | grep inet; ping -c 2 1.1.1.1 | tail -2} 60
    run {docker pull -q busybox && docker run --rm busybox echo pulled and ran busybox} 600
}
run {docker ps -a}
run {dd if=/dev/zero of=/root/t bs=1M count=200 conv=fsync 2>&1 | tail -1; rm /root/t} 300
run {echo NVMM-RUN-DOCKER-TEST-DONE}
after 700
send "poweroff\r"
set timeout 120
expect {
    eof {}
    timeout { puts "\n### TIMEOUT waiting for the VM to stop"; exit 1 }
}
lassign [wait] pid spawnid oserr status
puts "\n### nvmm-run exited with status $status"
exit $status
