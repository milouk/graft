#!/usr/bin/expect -f
#
# docker-test.exp — boot Alpine Linux under QEMU's nvmm accelerator, install
# Docker inside it, and run `docker ps -a` and a container.
#
#   sudo ./docker-test.exp <qemu-system-x86_64> <alpine-virt.iso> <disk.qcow2>
#
# In the environment: SMP=n sets the number of virtual CPUs (default 1),
# MEM the guest's memory (default 2G), ACCEL the accelerator (default nvmm;
# tcg needs no driver and no root, and is slow), QEMU_EXTRA adds arguments.
# The Alpine release in the repository URLs below must match the ISO.

if {$argc != 3} {
    puts "usage: docker-test.exp <qemu-system-x86_64> <alpine-virt.iso> <disk.qcow2>"
    exit 2
}
lassign $argv qemu iso disk

set smp 1
if {[info exists env(SMP)]} { set smp $env(SMP) }

# QEMU_EXTRA in the environment adds arguments, for debugging.
set extra {}
if {[info exists env(QEMU_EXTRA)]} { set extra [split $env(QEMU_EXTRA)] }
set accel nvmm
if {[info exists env(ACCEL)]} { set accel $env(ACCEL) }
set mem 2G
if {[info exists env(MEM)]} { set mem $env(MEM) }

# QEMU does not run on a terminal of this script's. It treats a hangup of its
# terminal as a request to quit, and says so only to that terminal, which
# makes a dropped terminal look like a guest that powered itself off. The
# guest's console is a socket instead, and QEMU's messages go to a file.
set dir [file dirname [file normalize $disk]]
set sock $dir/serial.sock
set qerr $dir/qemu.err
file delete -force $sock
set qpid [exec $qemu -accel $accel -M q35 -m $mem -smp $smp -display none \
    -monitor none -serial unix:$sock,server=on,wait=off \
    -cdrom $iso -drive file=$disk,if=virtio \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 {*}$extra \
    < /dev/null > $qerr 2>@1 &]
puts "QEMU is pid $qpid; its messages are in $qerr"

for {set i 0} {$i < 50 && ![file exists $sock]} {incr i} { after 100 }
if {![file exists $sock]} {
    puts "### QEMU did not start:"
    catch {puts [exec cat $qerr]}
    exit 1
}

set timeout 180
spawn nc -U $sock

# What QEMU said, and whether it is still running.
proc qemu_status {} {
    global qpid qerr
    after 500
    set alive [expr {![catch {exec kill -0 $qpid}]}]
    set msg ""
    catch {set msg [exec grep -v "Unexpected .*MSR" $qerr]}
    return "[expr {$alive ? "still running" : "gone"}]; messages: $msg"
}

proc run {cmd {t 180}} {
    set timeout $t
    send -- "$cmd\r"
    expect {
        -re {localhost:~# $} {}
        timeout { puts "\n### TIMEOUT waiting after: $cmd ([qemu_status])"; exit 1 }
        eof { puts "\n### CONSOLE CLOSED during: $cmd ([qemu_status])"; exit 1 }
    }
}

expect {
    "login: " {}
    timeout { puts "\n### TIMEOUT waiting for the login prompt ([qemu_status])"; exec kill $qpid; exit 1 }
    eof { puts "\n### CONSOLE CLOSED before login ([qemu_status])"; exit 1 }
}
send "root\r"
expect -re {localhost:~# $}

run {uname -a; nproc; free -m | head -2; date}
# OpenRC will not start Docker unless its "networking" service is up, and
# that service wants this file.
run {printf 'auto lo\niface lo inet loopback\n\nauto eth0\niface eth0 inet dhcp\n' > /etc/network/interfaces}
run {rc-service networking start; ip -4 addr show eth0 | grep inet} 90
run {echo https://dl-cdn.alpinelinux.org/alpine/v3.24/main > /etc/apk/repositories}
run {echo https://dl-cdn.alpinelinux.org/alpine/v3.24/community >> /etc/apk/repositories}
run {apk update} 120
run {apk add e2fsprogs docker} 900
run {mkfs.ext4 -q -F /dev/vda && mkdir -p /var/lib/docker && mount /dev/vda /var/lib/docker && df -h /var/lib/docker | tail -1} 120
run {rc-service cgroups start; rc-service docker start} 120
run {for i in $(seq 30); do docker info >/dev/null 2>&1 && break; sleep 2; done; docker version | grep -E "^(Client|Server)| Version"} 120
run {docker ps -a} 60
run {docker run --rm hello-world} 900
run {docker run --rm alpine sh -c "echo hello from a container on \$(uname -m), kernel \$(uname -r)"} 900
run {docker ps -a} 60
run {echo NVMM-DOCKER-TEST-DONE}
send "poweroff\r"
set timeout 90
expect eof
puts "\n### after poweroff: QEMU [qemu_status]"
